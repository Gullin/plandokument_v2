@{
    Layout = "_Layout";
}
@section StylesFiles {
    <link rel="stylesheet" href="lib/ol-10.6.1/ol.css" />
    <link rel="stylesheet" href="lib/ol-ext-4.0.33/ol-ext.css" />
}
@section Config {
    <script src="~/js/config.js"></script>
    <script type="text/javascript">
        Lkr.Plan.Dokument.resolvedClientUrl = "@($"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.PathBase}".TrimEnd('/'))";
    </script>
}
@section JsMap {
    <script type="text/javascript" src="~/lib/proj4-2.19.3/proj4.js"></script>
    <script type="text/javascript" src="~/lib/ol-10.6.1/ol.js"></script>
    <script type="text/javascript" src="~/lib/ol-ext-4.0.33/ol-ext.js"></script>
    <script type="text/javascript" src="~/js/ol-mapbackground.js"></script>
}
@section Script {
    <script type="text/javascript">
        const map = new MapBackground('mapcontainer');
        map.addAllPlans(true);
    </script>
}

@section Styles {
    <style>
        * {
            box-sizing: border-box;
        }

        html,
        body {
            height: 100%;
            margin: 0;
            font-size: 1em;
            line-height: 1em;
            font-family: Verdana, Arial, sans-serif;
        }

        p {
            margin: 0;
        }

        #versionWrapper {
            font-size: 0.65em;
        }

        #copyrightWrapper {
            left: 1em;
            font-size: 0.65em;
        }

        .ol-zoom-extent-map {
            position: absolute;
            left: 1em;
            top: 1em;
        }

        .ol-zoom-extent-object {
            position: absolute;
            left: 1em;
            top: 3em;
        }

        .ol-fullscreen {
            position: absolute;
            right: 1em;
            bottom: 1em;
        }

        .ol-popup-content {
            font-size: 0.7em;
            line-height: 1em;
        }

            .ol-popup-content h6 {
                font-size: 1em;
                line-height: 1em;
                margin: 0;
                padding: 0;
            }
    </style>
}




<div id="mapcontainer" style="position: relative; min-height: 100vh;"></div>
