{
  // Application metadata
  "Application": {
    // Ska vara samma path som definieras i webhostingen som exv. IIS
    "BasePath": "",
    // version åsidosätter versionering i assemblyinfo (ProductVersion)
    "Version": "",
    "VersionSuffix": "alfa",
    "Authorizations": {
      "Admins": {
        // Grupper och användare som har admin-åtkomst till applikationen. Användare måste skrivas på formen domän\\användare p.g.a. escape-tecken i JSON.
        // Sätts med fördel i Environment-variabler i produktionsmiljön.
        "AllowedUsers": [
        ],
        "AllowedGroups": [
        ]
      }
    },
    "SearchParams": {
      "URLQueryStringSeparator": ",",
      "URLParcelBlockUnitSign": "_",
      "UrlParameterSearchString": "q",
      "UrlParameterDocumentType": "dokument",
      "UrlParameterSearchType": "begrepp"
    }
  },
  "Databases": {
    "SqlServer": {
      "provider": "Microsoft.Data.SqlClient",
      "ConnectionString": "Server=localhost;Database=;User Id=;Password=;Encrypt=False;"
    },
    "Postgres": {
      "provider": "Npgsql",
      "ConnectionString": "Host=localhost;Username=;Password=;Database=;"
    },
    "Sqlite": {
      "provider": "Microsoft.Data.Sqlite",
      //"ConnectionString": "Data Source=PlandokumentAppDb.sqlite;Version=3;"
      "ConnectionString": "Data Source=log/PlandokumentAppDb.sqlite;"
    }
  },
  "Caches": {
    // Tiden för när cache ska uppdateras. Sätts förslagvis inte samtidigt som applikationen startas genom exv. Sätts i relation till IIS Application Pool Recycle.
    // Om applikationen startas om vis 05:00:00 så kan cache uppdateras halvvägs in under arbetsdagen.
    "RefreshTime": "12:15:00",
    "DocumentTypes": {
      "CacheKey": "DocumentTypes"
    },
    "PlanBas": {
      "CacheKey": "PlanBas"
    },
    "PlanBerorPlan": {
      "CacheKey": "PlanBerorPlan"
    },
    "PlanBerorFastighet": {
      "CacheKey": "PlanBerorFastighet"
    },
    "PlanGeometriesAllAsGeoJSON": {
      "CacheKey": "PlanGeometriesAllAsGeoJSON"
    },
    "PlanDocuments": {
      "CacheKey": "PlanDocuments"
    }
  },
  "PlanDocumentFiles": {
    "Paths": [
      // Sökväg med enkel slash /
      {
        "Physical": "C:/dev/plandokument_v1/src/web/plandokument",
        "Virtual": "plandokument",
        "ThumbnailSubFolder": "auto-miniatyrbild-plankarta"
      }
    ],
    "CrawlSubDirectories": true,
    "FileTypes": [ ".pdf", ".tif" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    },
    "ApplicationSpecificLogging": {
      // Relativ sökväg från applikationsrot
      "RootPath": "log",
      "GeneralLogFile": "general.log",
      "ErrorLogFile": "error.log",
      "RotationOfFile": {
        "Enabled": true,
        "Mode": "Size", // "Date" (daglig) or "Size"
        "MaxFileSizeInMB": 5,
        "MaxRetainedFiles": 10
      },
      // Loggar statistik i SQLite-databas
      "StatisticsRequest": {
        "Enabled": true
      }
    }
  },
  "AllowedHosts": "*"
}
